{
  "name": "@microflow/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./flow-invitation": {
      "default": "./src/flow-invitation.ts"
    },
    "./schema/*": {
      "default": "./src/schema/*.ts"
    },
    "./testing": {
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "migrate": "bun run src/migrate.ts",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@microflow/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@microflow/config": "workspace:*",
    "@types/pg": "catalog:",
    "drizzle-kit": "^0.31.9",
    "typescript": "catalog:"
  }
}
